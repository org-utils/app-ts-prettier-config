{
  "name": "ts-prettier-config",
  "version": "0.0.8",
  "description": "Shared TypeScript, ESLint, and Prettier configurations for Node.js and TypeScript projects",
  "keywords": [
    "typescript",
    "config",
    "tsconfig",
    "eslint",
    "prettier",
    "node",
    "shared-config",
    "eslint-config",
    "prettier-config"
  ],
  "author": "Anwar <anwarkamal1434@gmail.com>",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/org-utils/app-ts-prettier-config.git"
  },
  "homepage": "https://github.com/org-utils/app-ts-prettier-config#readme",
  "bugs": {
    "url": "https://github.com/org-utils/app-ts-prettier-config/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "sideEffects": false,
  "files": [
    "tsconfig/*.json",
    "prettier/*.mjs",
    "prettier/.prettierignore",
    "eslint/*.js",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    "./tsconfig/base": "./tsconfig/tsconfig.base.json",
    "./tsconfig/node": "./tsconfig/tsconfig.node.json",
    "./tsconfig/library": "./tsconfig/tsconfig.library.json",
    "./tsconfig/bundler": "./tsconfig/tsconfig.bundler.json",
    "./tsconfig/next": "./tsconfig/tsconfig.next.json",
    "./tsconfig/react": "./tsconfig/tsconfig.react.json",
    "./tsconfig/react-library": "./tsconfig/tsconfig.react-library.json",
    "./prettier": "./prettier/prettier.config.mjs",
    "./prettier/sort-imports": "./prettier/prettier.sort-imports.config.mjs",
    "./prettier/ignore": "./prettier/.prettierignore",
    "./eslint": "./eslint/index.js",
    "./eslint/base": "./eslint/base.js",
    "./eslint/node": "./eslint/node.js",
    "./eslint/library": "./eslint/library.js",
    "./eslint/strict": "./eslint/strict.js",
    "./eslint/prettier": "./eslint/prettier.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": ">=5.5.0"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    },
    "@trivago/prettier-plugin-sort-imports": {
      "optional": true
    }
  },
  "dependencies": {
    "commander": "^15.0.0",
    "jsonc-parser": "^3.3.1"
  },
  "bin": {
    "ts-prettier-config": "./bin/cli.js"
  },
  "scripts": {
    "test": "node --test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prepack": "npm test",
    "dev": "node bin/cli.js",
    "changesets:init": "changeset init",
    "changeset": "changeset",
    "version": "changeset version",
    "publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1"
  }
}
